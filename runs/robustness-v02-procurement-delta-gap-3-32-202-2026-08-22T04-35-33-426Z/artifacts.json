{
  "candidate": {
    "id": "procurement-delta-purchase-request-workflow",
    "organizationId": "procurement-delta",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "supplier-assurance",
            "reason": "Vendor is not approved; route to supplier-assurance per policy."
          }
        ],
        "provenance": [
          "procurement-delta-vendor-policy",
          "procurement-delta-message-6"
        ]
      },
      {
        "id": "amount-over-4200",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 4200
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "finance_operations_director",
            "reason": "Amount exceeds $4200; requires finance operations director approval."
          }
        ],
        "provenance": [
          "procurement-delta-approval-policy",
          "procurement-delta-message-13"
        ]
      },
      {
        "id": "amount-between-650-and-4200",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 650
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 4200
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "sourcing_manager",
            "reason": "Amount exceeds $650 and is up to $4200; requires sourcing manager approval."
          }
        ],
        "provenance": [
          "procurement-delta-approval-policy",
          "procurement-delta-limit-v2",
          "procurement-delta-message-5"
        ]
      },
      {
        "id": "amount-at-or-below-650",
        "when": {
          "op": "lte",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 650
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "submit_purchase_order",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "supplierKey": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "set_purchase_request_state",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-delta-limit-v2",
          "procurement-delta-message-1",
          "procurement-delta-message-3",
          "procurement-delta-completion-policy"
        ]
      }
    ],
    "provenance": [
      "procurement-delta-vendor-policy",
      "procurement-delta-limit-v2",
      "procurement-delta-approval-policy",
      "procurement-delta-completion-policy"
    ],
    "status": "candidate"
  },
