    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "verification-operations",
            "reason": "Unverified accounts must never receive credits; route them to verification-operations."
          }
        ],
        "provenance": [
          "support-harbor-identity-policy",
          "support-harbor-message-2"
        ]
      },
      {
        "id": "standard-within-limit",
