            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-exceptions",
            "reason": "Unverified accounts must never receive credits; route to identity-exceptions."
          }
        ],
        "provenance": [
          "support-cedar-identity-policy"
        ]
      },
      {
        "id": "standard-credit-within-limit",
        "when": {
          "op": "all",
          "args": [
