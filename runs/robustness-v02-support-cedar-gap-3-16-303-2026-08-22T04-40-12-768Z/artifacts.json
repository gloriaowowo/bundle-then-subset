                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
