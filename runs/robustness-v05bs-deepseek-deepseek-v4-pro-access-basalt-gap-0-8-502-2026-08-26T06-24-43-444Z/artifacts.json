              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "approved"
              }
            }
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-action-schema",
          "access-basalt-status-schema"
        ]
      },
      {
        "id": "manual-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.identityVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Eligible request above automatic threshold requires platform_security_manager approval."
          }
        ],
        "provenance": [
