{
  "candidate": {
    "id": "access-basalt-access_provisioning-workflow",
    "organizationId": "access-basalt",
    "taskFamily": "access_provisioning",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "access_provisioning"
      }
    },
    "rules": [
      {
        "id": "identity-verification-required",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.identityVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-review-desk",
            "reason": "Request without verified member identity must be routed to identity-review-desk per policy."
          }
        ],
        "provenance": [
          "access-basalt-eligibility-policy"
        ]
      },
      {
        "id": "automatic-access-eligible",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.identityVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "enable_platform_access",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "memberKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "scoredRisk": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "completed"
              }
            }
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-action-schema",
          "access-basalt-status-schema"
        ]
      },
      {
        "id": "approval-required-above-threshold",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.identityVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Eligible requests above automatic threshold require platform_security_manager approval and must pause without executing platform access."
          }
        ],
        "provenance": [
          "access-basalt-approval-policy",
          "access-basalt-limit-v2"
        ]
      }
    ],
    "provenance": [
      "access-basalt-eligibility-policy",
