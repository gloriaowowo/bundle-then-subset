    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "rule-unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "vendor-controls",
            "reason": "Vendor is not approved; route to vendor-controls per policy."
          }
        ],
        "provenance": [
          "procurement-mesa-vendor-policy",
          "procurement-mesa-vendor-schema",
          "procurement-mesa-message-6"
        ]
      },
      {
        "id": "rule-approved-vendor-low-value",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.vendorApproved"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 1350
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "create_sourcing_order",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "vendorRef": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_requisition",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-mesa-limit-v2",
          "procurement-mesa-order-schema",
          "procurement-mesa-status-schema",
          "procurement-mesa-message-1",
          "procurement-mesa-message-3",
          "procurement-mesa-message-5",
          "procurement-mesa-message-9",
          "procurement-mesa-completion-policy"
        ]
      },
      {
        "id": "rule-approved-vendor-medium-value",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.vendorApproved"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 1350
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 7200
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "category_owner",
            "reason": "Order amount exceeds agent limit and requires category_owner approval."
          }
        ],
        "provenance": [
          "procurement-mesa-approval-policy",
          "procurement-mesa-limit-v2",
          "procurement-mesa-message-14",
          "procurement-mesa-message-15",
          "procurement-mesa-message-18"
        ]
      },
      {
