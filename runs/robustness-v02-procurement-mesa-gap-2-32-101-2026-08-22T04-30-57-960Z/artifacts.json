            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.vendorApproved"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 7200
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
