    "rules": [
      {
        "id": "rule-approved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": true
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "open_procurement_order",
            "args": {
              "requestId": {
                "kind": "path",
