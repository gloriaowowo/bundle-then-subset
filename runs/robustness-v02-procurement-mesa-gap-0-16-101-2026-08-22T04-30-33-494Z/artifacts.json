{
  "candidate": {
    "id": "procurement-mesa-purchase-request-workflow",
    "organizationId": "procurement-mesa",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "vendor-not-approved",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "vendor-controls",
            "reason": "Vendor is not approved; route to vendor-controls per policy."
          }
        ],
        "provenance": [
          "procurement-mesa-vendor-policy",
          "procurement-mesa-message-6"
        ]
      },
      {
        "id": "amount-above-corporate-limit",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 7200
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "corporate_controller",
            "reason": "Amount exceeds $7200; requires corporate_controller approval."
          }
        ],
        "provenance": [
          "procurement-mesa-approval-policy"
        ]
      },
      {
        "id": "amount-between-agent-and-corporate-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 1350
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 7200
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "category_owner",
            "reason": "Amount exceeds agent limit and is within category owner approval range."
          }
        ],
        "provenance": [
          "procurement-mesa-approval-policy",
          "procurement-mesa-limit-v2",
          "procurement-mesa-message-5"
        ]
      },
      {
        "id": "amount-within-agent-limit",
        "when": {
          "op": "lte",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 1350
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "create_sourcing_order",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "vendorRef": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_requisition",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-mesa-limit-v2",
          "procurement-mesa-order-schema",
          "procurement-mesa-status-schema",
          "procurement-mesa-message-1",
          "procurement-mesa-message-3",
          "procurement-mesa-message-7"
        ]
      }
    ],
