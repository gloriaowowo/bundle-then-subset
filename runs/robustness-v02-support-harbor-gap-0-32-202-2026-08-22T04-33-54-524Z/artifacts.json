            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 110
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
