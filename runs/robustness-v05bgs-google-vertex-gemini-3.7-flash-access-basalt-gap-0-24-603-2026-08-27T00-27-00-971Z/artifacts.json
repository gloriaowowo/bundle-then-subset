                    },
                    {
                      "op": "lte",
                      "left": {
                        "kind": "path",
                        "path": "input.riskScore"
                      },
                      "right": {
                        "kind": "literal",
                        "value": 30
                      }
                    }
                  ]
                },
                {
                  "op": "all",
                  "args": [
                    {
                      "op": "eq",
                      "left": {
                        "kind": "path",
                        "path": "input.accessClass"
                      },
                      "right": {
                        "kind": "literal",
                        "value": "operator"
