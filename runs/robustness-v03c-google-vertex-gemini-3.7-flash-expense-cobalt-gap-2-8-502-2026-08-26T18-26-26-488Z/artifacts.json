                "kind": "path",
                "path": "input.reportId"
              },
              "workerRef": {
                "kind": "path",
                "path": "input.employeeId"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_expense_claim",
            "args": {
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "paid"
              }
            }
          }
        ],
        "provenance": [
          "expense-cobalt-limit-v2",
          "expense-cobalt-action-schema",
          "expense-cobalt-status-schema",
          "expense-cobalt-message-1",
          "expense-cobalt-message-3"
        ]
      },
      {
        "id": "manual-approval-rule",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
