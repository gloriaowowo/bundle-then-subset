              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "local"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 160
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "reimbursement_lead",
            "reason": "Eligible requests above their applicable automatic threshold require reimbursement_lead approval"
          }
        ],
        "provenance": [
          "expense-cobalt-limit-v2",
          "expense-cobalt-approval-policy",
          "expense-cobalt-message-2"
        ]
      },
      {
        "id": "cross-border-approval-required",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "cross_border"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 620
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "reimbursement_lead",
            "reason": "Eligible cross_border requests above 620 require reimbursement_lead approval"
          }
        ],
        "provenance": [
          "expense-cobalt-special-policy",
          "expense-cobalt-approval-policy",
          "expense-cobalt-message-2"
        ]
      },
      {
        "id": "execute-repayment-and-finalize",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": true
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "post_employee_repayment",
            "args": {
              "actionClass": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "claimAmount": {
                "kind": "path",
                "path": "input.amount"
              },
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "workerRef": {
                "kind": "path",
                "path": "input.employeeId"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_expense_claim",
            "args": {
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "paid"
              }
            }
          }
        ],
        "provenance": [
          "expense-cobalt-action-schema",
          "expense-cobalt-status-schema",
          "expense-cobalt-completion-policy",
          "expense-cobalt-message-3",
