              },
              "right": {
                "kind": "literal",
                "value": "enterprise"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 275
