{
  "candidate": {
    "id": "support-cedar-support_credit-workflow",
    "organizationId": "support-cedar",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-exceptions",
            "reason": "Unverified accounts must never receive credits; route to identity-exceptions."
          }
        ],
        "provenance": [
          "support-cedar-identity-policy",
          "support-cedar-message-2"
        ]
      },
      {
        "id": "verified-standard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "create_service_adjustment",
            "args": {
              "memberId": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "service_credit"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_support_case",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-cedar-limit-v2",
          "support-cedar-credit-schema",
          "support-cedar-status-schema",
          "support-cedar-message-1"
        ]
      },
      {
        "id": "verified-standard-credit-requires-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "care_team_lead",
            "reason": "Credits above the automatic limit require care_team_lead approval."
          }
        ],
        "provenance": [
          "support-cedar-approval-policy",
          "support-cedar-limit-v2"
        ]
      },
      {
        "id": "verified-nonstandard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "neq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "care_team_lead",
            "reason": "Non-standard tiers require care_team_lead approval for credits."
          }
        ],
        "provenance": [
          "support-cedar-approval-policy"
        ]
      }
    ],
    "provenance": [
      "support-cedar-identity-policy",
      "support-cedar-limit-v2",
      "support-cedar-approval-policy",
      "support-cedar-credit-schema",
