{
  "candidate": {
    "id": "support-orion-support_credit-workflow",
    "organizationId": "support-orion",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-assurance",
            "reason": "Unverified accounts must never receive credits; route to identity-assurance."
          }
        ],
        "provenance": [
          "support-orion-identity-policy",
          "support-orion-message-2"
        ]
      },
      {
        "id": "verified-standard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 85
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "apply_customer_credit",
            "args": {
              "profileId": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "standard"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_service_case",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-orion-limit-v2",
          "support-orion-credit-schema",
          "support-orion-status-schema"
        ]
      },
      {
        "id": "verified-standard-credit-requires-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 85
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "service_manager",
            "reason": "Credits above the applicable automatic limit require service_manager approval."
          }
        ],
        "provenance": [
          "support-orion-approval-policy",
          "support-orion-limit-v2"
        ]
      },
      {
        "id": "verified-nonstandard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "neq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "service_manager",
            "reason": "Non-standard tiers require service_manager approval for credits."
          }
        ],
        "provenance": [
          "support-orion-approval-policy"
        ]
      }
    ],
    "provenance": [
      "support-orion-identity-policy",
      "support-orion-limit-v2",
      "support-orion-approval-policy",
      "support-orion-credit-schema",
      "support-orion-status-schema",
