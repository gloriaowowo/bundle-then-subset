{
  "candidate": {
    "id": "procurement-delta-purchase-request-workflow",
    "organizationId": "procurement-delta",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "rule-unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "supplier-assurance",
            "reason": "Vendor is not approved; route to supplier-assurance per policy."
          }
        ],
        "provenance": [
          "procurement-delta-vendor-policy",
          "procurement-delta-message-6"
        ]
      },
      {
        "id": "rule-amount-over-limit",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 650
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "procurement_owner",
            "reason": "Amount exceeds $650 limit; requires approval."
          }
        ],
        "provenance": [
          "procurement-delta-limit-v2",
          "procurement-delta-message-5"
        ]
      },
      {
        "id": "rule-amount-within-limit",
        "when": {
          "op": "lte",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 650
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "submit_purchase_order",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "supplierKey": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "set_purchase_request_state",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-delta-limit-v2",
          "procurement-delta-message-1",
          "procurement-delta-message-3",
          "procurement-delta-message-5",
          "procurement-delta-message-9"
        ]
      }
    ],
    "provenance": [
