{
  "candidate": {
    "id": "expense-verbena-reimbursement-workflow",
    "organizationId": "expense-verbena",
    "taskFamily": "expense_reimbursement",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "expense_reimbursement"
      }
    },
    "rules": [
      {
        "id": "check-receipt-verification",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "program-evidence-review",
            "reason": "A request without a verified receipt must be routed to program-evidence-review."
          }
        ],
        "provenance": [
          "expense-verbena-eligibility-policy",
          "expense-verbena-message-4"
        ]
      },
      {
        "id": "sponsored-event-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "sponsored_event"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 720
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "program_finance_owner",
            "reason": "sponsored_event request amount exceeds the automatic threshold of 720."
          }
        ],
        "provenance": [
          "expense-verbena-special-policy",
          "expense-verbena-approval-policy"
        ]
      },
      {
        "id": "standard-program-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "neq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "sponsored_event"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 185
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "program_finance_owner",
            "reason": "Program request amount exceeds the automatic threshold of 185."
          }
        ],
        "provenance": [
          "expense-verbena-limit-v2",
          "expense-verbena-approval-policy",
          "expense-verbena-correction-1"
        ]
      },
      {
        "id": "execute-repayment-and-finalize",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": true
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "issue_program_repayment",
            "args": {
              "actionClass": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "memberRef": {
                "kind": "path",
                "path": "input.employeeId"
              },
              "programReportId": {
                "kind": "path",
                "path": "input.reportId"
              },
              "repaymentAmount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_program_report",
            "args": {
              "programReportId": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "repaid"
              }
            }
          }
        ],
        "provenance": [
          "expense-verbena-action-schema",
          "expense-verbena-status-schema",
          "expense-verbena-completion-policy",
          "expense-verbena-message-3",
          "expense-verbena-message-13"
        ]
      }
    ],
    "provenance": [
      "expense-verbena-eligibility-policy",
      "expense-verbena-limit-v2",
