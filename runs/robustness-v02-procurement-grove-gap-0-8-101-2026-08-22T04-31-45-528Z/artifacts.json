{
  "candidate": {
    "id": "procurement-grove-purchase-request-workflow",
    "organizationId": "procurement-grove",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "rule-unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "new-vendor-review",
            "reason": "Vendor is not approved; route to new-vendor-review per policy."
          }
        ],
        "provenance": [
          "procurement-grove-vendor-policy"
        ]
      },
      {
        "id": "rule-high-amount-requires-financial-controller",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 3600
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "financial_controller",
            "reason": "Amount exceeds $3600; requires financial_controller approval."
          }
        ],
        "provenance": [
          "procurement-grove-approval-policy"
        ]
      },
      {
        "id": "rule-mid-amount-requires-budget-manager",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 500
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 3600
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "budget_manager",
            "reason": "Amount exceeds agent limit ($500) and is up to $3600; requires budget_manager approval."
          }
        ],
        "provenance": [
          "procurement-grove-approval-policy",
          "procurement-grove-limit-v2"
        ]
      },
      {
        "id": "rule-low-amount-approved-vendor-straight-through",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.vendorApproved"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 500
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "issue_purchase_commitment",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "supplierId": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_buy_request",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "approved"
              }
            }
          }
        ],
        "provenance": [
          "procurement-grove-message-1",
          "procurement-grove-limit-v2",
          "procurement-grove-order-schema",
          "procurement-grove-status-schema"
        ]
      }
    ],
    "provenance": [
      "procurement-grove-vendor-policy",
      "procurement-grove-limit-v2",
      "procurement-grove-approval-policy",
      "procurement-grove-order-schema",
      "procurement-grove-status-schema",
      "procurement-grove-message-1",
      "procurement-grove-message-2"
    ],
    "status": "candidate"
  },
