{
  "candidate": {
    "id": "access-basalt-access-provisioning-workflow",
    "organizationId": "access-basalt",
    "taskFamily": "access_provisioning",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "access_provisioning"
      }
    },
    "rules": [
      {
        "id": "rule-unverified-identity",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.identityVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-review-desk",
            "reason": "A request without a verified member identity must never receive an automated platform access; route it to identity-review-desk."
          }
        ],
        "provenance": [
          "access-basalt-eligibility-policy"
        ]
      },
      {
        "id": "rule-high-risk-approval",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.riskScore"
          },
          "right": {
            "kind": "literal",
            "value": 30
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Eligible requests above their applicable automatic threshold require platform_security_manager approval."
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-approval-policy",
          "access-basalt-message-2"
        ]
      },
      {
        "id": "rule-auto-provision",
        "when": {
          "op": "lte",
          "left": {
            "kind": "path",
            "path": "input.riskScore"
          },
          "right": {
            "kind": "literal",
            "value": 30
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "enable_platform_access",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "memberKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "scoredRisk": {
                "kind": "path",
                "path": "input.riskScore"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "COMPLETED"
              }
            }
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-action-schema",
          "access-basalt-status-schema",
          "access-basalt-message-1"
        ]
      }
    ],
    "provenance": [
      "access-basalt-eligibility-policy",
      "access-basalt-limit-v2",
      "access-basalt-approval-policy",
      "access-basalt-action-schema",
