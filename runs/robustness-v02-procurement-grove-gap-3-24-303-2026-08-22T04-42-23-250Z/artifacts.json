{
  "candidate": {
    "id": "procurement-grove-purchase-request-workflow",
    "organizationId": "procurement-grove",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "new-vendor-review",
            "reason": "Vendor is not approved; route to new-vendor-review per policy."
          }
        ],
        "provenance": [
          "procurement-grove-vendor-policy",
          "procurement-grove-message-6"
        ]
      },
      {
        "id": "amount-over-3600",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 3600
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "finance_director",
            "reason": "Amount exceeds $3600; requires finance director approval."
          }
        ],
        "provenance": [
          "procurement-grove-message-13"
        ]
      },
      {
        "id": "amount-over-500",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 500
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "budget_manager",
            "reason": "Amount exceeds $500; requires budget manager approval."
          }
        ],
        "provenance": [
          "procurement-grove-limit-v2",
          "procurement-grove-message-5"
        ]
      },
      {
        "id": "approved-vendor-within-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.vendorApproved"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 500
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "issue_purchase_commitment",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "supplierId": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_buy_request",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-grove-order-schema",
          "procurement-grove-status-schema",
          "procurement-grove-message-1",
          "procurement-grove-message-3",
          "procurement-grove-completion-policy"
        ]
      }
    ],
    "provenance": [
