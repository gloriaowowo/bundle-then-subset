{
  "candidate": {
    "id": "expense-cobalt-expense_reimbursement-workflow",
    "organizationId": "expense-cobalt",
    "taskFamily": "expense_reimbursement",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "expense_reimbursement"
      }
    },
    "rules": [
      {
        "id": "missing-documentation",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "documentation-assurance",
            "reason": "Receipt not verified; route to documentation-assurance per policy."
          }
        ],
        "provenance": [
          "expense-cobalt-eligibility-policy"
        ]
      },
      {
        "id": "above-threshold-approval",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 160
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "reimbursement_lead",
            "reason": "Amount exceeds automatic threshold; requires reimbursement_lead approval."
          },
          {
            "kind": "escalate",
            "queue": "reimbursement_lead",
            "reason": "Awaiting approval before repayment."
          }
        ],
        "provenance": [
          "expense-cobalt-approval-policy",
          "expense-cobalt-limit-v2"
        ]
      },
      {
        "id": "automatic-repayment",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.receiptVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 160
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "post_employee_repayment",
            "args": {
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "workerRef": {
                "kind": "path",
                "path": "input.employeeId"
              },
              "claimAmount": {
                "kind": "path",
                "path": "input.amount"
              },
              "actionClass": {
                "kind": "literal",
                "value": "automatic"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_expense_claim",
            "args": {
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "repaid"
              }
            }
          }
        ],
        "provenance": [
          "expense-cobalt-limit-v2",
          "expense-cobalt-action-schema",
          "expense-cobalt-status-schema"
        ]
      }
    ],
    "provenance": [
