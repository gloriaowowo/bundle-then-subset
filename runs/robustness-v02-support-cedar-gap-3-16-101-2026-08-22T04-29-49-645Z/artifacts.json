{
  "candidate": {
    "id": "support-cedar-support_credit-workflow",
    "organizationId": "support-cedar",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-exceptions",
            "reason": "Unverified accounts must never receive credits per support-cedar-identity-policy."
          }
        ],
        "provenance": [
          "support-cedar-identity-policy"
        ]
      },
      {
        "id": "verified-standard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "create_service_adjustment",
            "args": {
              "memberId": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "standard"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_support_case",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-cedar-limit-v2",
          "support-cedar-credit-schema",
          "support-cedar-status-schema",
          "support-cedar-message-3"
        ]
      },
      {
        "id": "verified-standard-credit-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "manager",
            "reason": "Standard credit amount exceeds automatic limit of $45 per support-cedar-limit-v2."
          }
        ],
        "provenance": [
          "support-cedar-limit-v2"
        ]
      },
