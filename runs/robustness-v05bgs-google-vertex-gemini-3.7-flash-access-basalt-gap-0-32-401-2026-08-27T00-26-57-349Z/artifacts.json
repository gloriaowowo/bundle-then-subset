            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Member risk score exceeds automatic threshold of 30"
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-approval-policy",
          "access-basalt-correction-1"
        ]
      },
      {
        "id": "provision-platform-access",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.identityVerified"
          },
          "right": {
            "kind": "literal",
            "value": true
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "enable_platform_access",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "memberKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "scoredRisk": {
                "kind": "path",
                "path": "input.riskScore"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
