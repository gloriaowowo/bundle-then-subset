{
  "candidate": {
    "id": "access-basalt-provisioning-workflow",
    "organizationId": "access-basalt",
    "taskFamily": "access_provisioning",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "access_provisioning"
      }
    },
    "rules": [
      {
        "id": "rule-unverified-identity",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.identityVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-review-desk",
            "reason": "Request without verified member identity must be routed to identity review desk"
          }
        ],
        "provenance": [
          "access-basalt-eligibility-policy"
        ]
      },
      {
        "id": "rule-high-risk-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.identityVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Requests above automatic threshold of 30 require platform_security_manager approval"
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-approval-policy",
          "access-basalt-message-2"
        ]
      },
      {
        "id": "rule-auto-provision",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.identityVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "enable_platform_access",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "memberKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "scoredRisk": {
                "kind": "path",
                "path": "input.riskScore"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "completed"
              }
            }
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-action-schema",
          "access-basalt-status-schema",
          "access-basalt-message-1"
        ]
      }
    ],
    "provenance": [
      "access-basalt-eligibility-policy",
      "access-basalt-limit-v2",
      "access-basalt-approval-policy",
      "access-basalt-action-schema",
