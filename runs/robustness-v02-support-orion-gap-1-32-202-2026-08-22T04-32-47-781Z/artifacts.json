{
  "candidate": {
    "id": "support-orion-support_credit-workflow",
    "organizationId": "support-orion",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-assurance",
            "reason": "Unverified accounts must never receive credits; route to identity-assurance."
          }
        ],
        "provenance": [
          "support-orion-identity-policy",
          "support-orion-message-2",
          "support-orion-message-6"
        ]
      },
      {
        "id": "standard-credit-within-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 85
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "apply_customer_credit",
            "args": {
              "profileId": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "refund_credit"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_service_case",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-orion-limit-v2",
          "support-orion-message-14",
          "support-orion-resolution-policy",
          "support-orion-message-3",
          "support-orion-message-9"
        ]
      },
      {
        "id": "standard-credit-over-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 85
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "service_manager",
            "reason": "Credits above the standard automatic limit require service_manager approval."
          }
        ],
        "provenance": [
