{
  "candidate": {
    "id": "support-cedar-support_credit-workflow",
    "organizationId": "support-cedar",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-exceptions",
            "reason": "Unverified accounts must never receive credits; route to identity-exceptions."
          }
        ],
        "provenance": [
          "support-cedar-identity-policy",
          "support-cedar-message-2",
          "support-cedar-message-6"
        ]
      },
      {
        "id": "standard-account-within-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "create_service_adjustment",
            "args": {
              "memberId": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "refund_credit"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_support_case",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-cedar-limit-v2",
          "support-cedar-message-14",
          "support-cedar-resolution-policy",
          "support-cedar-message-3",
          "support-cedar-message-7"
        ]
      },
      {
        "id": "standard-account-over-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 45
              }
            }
          ]
        },
        "steps": [
