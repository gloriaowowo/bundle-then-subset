    "rules": [
      {
        "id": "unverified-receipt-review",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "receipt-integrity-review",
            "reason": "A request without a verified receipt must be routed to receipt-integrity-review."
          }
        ],
        "provenance": [
          "expense-aurora-eligibility-policy"
        ]
      },
      {
        "id": "automatic-domestic-reimbursement",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.receiptVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "domestic"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 125
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "issue_expense_reimbursement",
            "args": {
              "actionClass": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "employeeKey": {
                "kind": "path",
                "path": "input.employeeId"
              },
              "reportId": {
                "kind": "path",
                "path": "input.reportId"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_expense_report",
            "args": {
              "reportId": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "reimbursed"
              }
            }
          }
        ],
        "provenance": [
          "expense-aurora-limit-v2",
          "expense-aurora-action-schema",
          "expense-aurora-status-schema",
          "expense-aurora-message-1",
          "expense-aurora-message-3"
        ]
      },
      {
        "id": "approval-required-reimbursement",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.receiptVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "any",
              "args": [
                {
                  "op": "neq",
                  "left": {
                    "kind": "path",
                    "path": "input.expenseClass"
                  },
                  "right": {
                    "kind": "literal",
                    "value": "domestic"
                  }
                },
                {
                  "op": "gt",
                  "left": {
                    "kind": "path",
                    "path": "input.amount"
                  },
                  "right": {
                    "kind": "literal",
                    "value": 125
                  }
                }
              ]
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "expense_operations_manager",
            "reason": "Reimbursement requires approval when exceeding automatic domestic limits."
          }
        ],
        "provenance": [
          "expense-aurora-limit-v2",
          "expense-aurora-message-2"
        ]
      }
    ],
