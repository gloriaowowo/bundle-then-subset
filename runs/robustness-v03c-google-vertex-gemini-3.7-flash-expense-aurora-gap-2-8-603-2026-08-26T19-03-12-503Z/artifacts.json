{
  "candidate": {
    "id": "expense-reimbursement-workflow",
    "organizationId": "expense-aurora",
    "taskFamily": "expense_reimbursement",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
