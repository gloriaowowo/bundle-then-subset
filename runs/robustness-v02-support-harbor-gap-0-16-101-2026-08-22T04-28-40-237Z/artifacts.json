{
  "candidate": {
    "id": "support-harbor-support_credit-workflow",
    "organizationId": "support-harbor",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "verification-operations",
            "reason": "Unverified accounts must never receive credits; route them to verification-operations."
          }
        ],
        "provenance": [
          "support-harbor-identity-policy",
          "support-harbor-message-2"
        ]
      },
      {
        "id": "standard-credit-within-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 110
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "grant_customer_balance",
            "args": {
              "customerRef": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "standard"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_support_ticket",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-harbor-limit-v2",
          "support-harbor-credit-schema",
          "support-harbor-status-schema",
          "support-harbor-message-3"
        ]
      },
      {
        "id": "standard-credit-above-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 110
              }
            }
          ]
        },
        "steps": [
