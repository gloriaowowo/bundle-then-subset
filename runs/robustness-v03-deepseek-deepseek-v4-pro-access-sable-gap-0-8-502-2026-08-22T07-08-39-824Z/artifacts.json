          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-exceptions",
            "reason": "Identity not verified; no automated directory access."
          }
        ],
        "provenance": [
          "access-sable-eligibility-policy"
        ]
      },
      {
        "id": "workforce-low-risk",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "right": {
                "kind": "literal",
                "value": "workforce"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 35
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "activate_directory_access",
            "args": {
              "ticketRef": {
                "kind": "path",
                "path": "input.requestId"
              },
              "userKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "assessedRisk": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "set_access_ticket_status",
            "args": {
              "ticketRef": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "completed"
              }
            }
          }
        ],
        "provenance": [
          "access-sable-limit-v2",
          "access-sable-message-1"
        ]
      },
      {
        "id": "workforce-above-threshold",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "right": {
                "kind": "literal",
                "value": "workforce"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 35
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "iam_operations_owner",
            "reason": "Risk score above automatic threshold; approval required before directory access."
          }
        ],
        "provenance": [
          "access-sable-approval-policy",
          "access-sable-limit-v2"
        ]
      },
      {
        "id": "non-workforce",
        "when": {
          "op": "neq",
          "left": {
            "kind": "path",
            "path": "input.accessClass"
          },
          "right": {
            "kind": "literal",
            "value": "workforce"
          }
        },
        "steps": [
          {
            "kind": "abstain",
            "reason": "No policy for non-workforce access classes."
          }
        ],
        "provenance": [
          "access-sable-eligibility-policy"
        ]
      }
    ],
    "provenance": [
      "access-sable-eligibility-policy",
