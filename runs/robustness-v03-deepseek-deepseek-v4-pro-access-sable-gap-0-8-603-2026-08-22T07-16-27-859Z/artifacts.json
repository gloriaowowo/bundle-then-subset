            "tool": "set_access_ticket_status",
            "args": {
              "ticketRef": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "completed"
              }
            }
          }
        ],
        "provenance": [
          "access-sable-limit-v2",
          "access-sable-message-1"
        ]
      },
      {
        "id": "workforce-above-threshold",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "right": {
                "kind": "literal",
                "value": "workforce"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 35
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "iam_operations_owner",
            "reason": "Risk score above automatic threshold; approval required before directory access."
          }
        ],
        "provenance": [
          "access-sable-approval-policy",
          "access-sable-limit-v2"
