{
  "candidate": {
    "id": "support-beacon-support_credit-workflow",
    "organizationId": "support-beacon",
    "taskFamily": "support_credit",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "support_credit"
      }
    },
    "rules": [
      {
        "id": "unverified-account",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.verified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "account-trust-review",
            "reason": "Unverified accounts must never receive credits; route to account-trust-review."
          }
        ],
        "provenance": [
          "support-beacon-identity-policy",
          "support-beacon-message-2"
        ]
      },
      {
        "id": "verified-standard-credit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 60
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "post_account_adjustment",
            "args": {
              "accountKey": {
                "kind": "path",
                "path": "input.customerId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              },
              "creditType": {
                "kind": "literal",
                "value": "credit"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "set_case_outcome",
            "args": {
              "ticketId": {
                "kind": "path",
                "path": "input.ticketId"
              },
              "status": {
                "kind": "literal",
                "value": "resolved"
              }
            }
          }
        ],
        "provenance": [
          "support-beacon-limit-v2",
          "support-beacon-credit-schema",
          "support-beacon-status-schema",
          "support-beacon-message-3"
        ]
      },
      {
        "id": "verified-standard-credit-over-limit",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.verified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.tier"
              },
              "right": {
                "kind": "literal",
                "value": "standard"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 60
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "manager",
            "reason": "Credit amount exceeds the standard automatic limit of $60."
          }
        ],
        "provenance": [
          "support-beacon-limit-v2"
        ]
      }
    ],
