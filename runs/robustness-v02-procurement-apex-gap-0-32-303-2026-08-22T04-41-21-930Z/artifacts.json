{
  "candidate": {
    "id": "procurement-apex-purchase-request-workflow",
    "organizationId": "procurement-apex",
    "taskFamily": "purchase_request",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "purchase_request"
      }
    },
    "rules": [
      {
        "id": "unapproved-vendor",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.vendorApproved"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "third-party-risk",
            "reason": "Vendor is not approved; route to third-party-risk per policy."
          }
        ],
        "provenance": [
          "procurement-apex-vendor-policy",
          "procurement-apex-message-6"
        ]
      },
      {
        "id": "auto-approve",
        "when": {
          "op": "lte",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 950
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "open_procurement_order",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "partnerId": {
                "kind": "path",
                "path": "input.vendorId"
              },
              "amount": {
                "kind": "path",
                "path": "input.amount"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "record_request_status",
            "args": {
              "requestId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "ordered"
              }
            }
          }
        ],
        "provenance": [
          "procurement-apex-limit-v2",
          "procurement-apex-message-9",
          "procurement-apex-message-17",
          "procurement-apex-order-schema",
          "procurement-apex-status-schema",
          "procurement-apex-message-3",
          "procurement-apex-completion-policy"
        ]
      },
      {
        "id": "procurement-lead-approval",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 950
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 6100
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "procurement_lead",
            "reason": "Order amount exceeds automatic limit and is within procurement lead approval range."
          }
        ],
        "provenance": [
          "procurement-apex-approval-policy",
          "procurement-apex-message-5",
          "procurement-apex-message-14",
          "procurement-apex-message-15",
          "procurement-apex-separation-policy"
        ]
      },
      {
        "id": "spend-governance-approval",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 6100
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "spend_governance_director",
            "reason": "Order amount exceeds procurement lead ceiling; requires spend governance director approval."
          }
        ],
        "provenance": [
          "procurement-apex-approval-policy",
          "procurement-apex-message-13",
          "procurement-apex-message-14",
          "procurement-apex-message-15",
          "procurement-apex-separation-policy"
        ]
      }
    ],
    "provenance": [
      "procurement-apex-vendor-policy",
      "procurement-apex-limit-v2",
      "procurement-apex-approval-policy",
      "procurement-apex-order-schema",
