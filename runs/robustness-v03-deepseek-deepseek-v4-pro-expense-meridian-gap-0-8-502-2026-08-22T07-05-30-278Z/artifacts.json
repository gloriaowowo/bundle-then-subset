    },
    "rules": [
      {
        "id": "missing-receipt-validation",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "evidence-validation",
            "reason": "Receipt not verified; route to evidence-validation per policy."
          }
        ],
        "provenance": [
          "expense-meridian-eligibility-policy"
        ]
      },
      {
        "id": "above-threshold-approval",
        "when": {
          "op": "gt",
          "left": {
            "kind": "path",
            "path": "input.amount"
          },
          "right": {
            "kind": "literal",
            "value": 225
          }
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "expense_control_owner",
            "reason": "Amount exceeds automatic threshold; requires expense_control_owner approval."
          },
          {
            "kind": "escalate",
            "queue": "expense_control_owner",
            "reason": "Pause without executing expense payment until approval."
          }
        ],
        "provenance": [
          "expense-meridian-limit-v2",
          "expense-meridian-approval-policy"
        ]
      },
      {
        "id": "automatic-payment",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.receiptVerified"
              },
              "right": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "lte",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 225
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "release_expense_payment",
            "args": {
              "reportKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "employeeRef": {
                "kind": "path",
                "path": "input.employeeId"
              },
              "paymentAmount": {
                "kind": "path",
                "path": "input.amount"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.expenseClass"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "update_report_disposition",
            "args": {
              "reportKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "paid"
              }
            }
          }
        ],
        "provenance": [
          "expense-meridian-limit-v2",
          "expense-meridian-action-schema",
          "expense-meridian-status-schema"
        ]
      }
    ],
    "provenance": [
