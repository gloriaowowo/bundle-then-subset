{
  "candidate": {
    "id": "expense-meridian-expense-reimbursement-workflow",
    "organizationId": "expense-meridian",
    "taskFamily": "expense_reimbursement",
    "version": 1,
    "trigger": {
      "op": "eq",
      "left": {
        "kind": "path",
        "path": "input.taskFamily"
      },
      "right": {
        "kind": "literal",
        "value": "expense_reimbursement"
