              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "right": {
                "kind": "literal",
                "value": "cross_border"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.amount"
              },
              "right": {
                "kind": "literal",
                "value": 620
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "reimbursement_lead",
            "reason": "Cross-border request exceeds automatic threshold of 620"
          }
        ],
        "provenance": [
          "expense-cobalt-special-policy",
          "expense-cobalt-approval-policy"
        ]
      },
      {
        "id": "process-automatic-reimbursement",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.receiptVerified"
          },
          "right": {
            "kind": "literal",
            "value": true
          }
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "post_employee_repayment",
            "args": {
              "actionClass": {
                "kind": "path",
                "path": "input.expenseClass"
              },
              "claimAmount": {
                "kind": "path",
                "path": "input.amount"
              },
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "workerRef": {
                "kind": "path",
                "path": "input.employeeId"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "finalize_expense_claim",
            "args": {
              "claimKey": {
                "kind": "path",
                "path": "input.reportId"
              },
              "status": {
                "kind": "literal",
                "value": "paid"
              }
            }
          }
        ],
        "provenance": [
          "expense-cobalt-action-schema",
          "expense-cobalt-status-schema",
          "expense-cobalt-completion-policy"
        ]
      }
    ],
