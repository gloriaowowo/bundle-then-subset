    "rules": [
      {
        "id": "rule-unverified-identity",
        "when": {
          "op": "eq",
          "left": {
            "kind": "path",
            "path": "input.identityVerified"
          },
          "right": {
            "kind": "literal",
            "value": false
          }
        },
        "steps": [
          {
            "kind": "escalate",
            "queue": "identity-review-desk",
            "reason": "A request without a verified member identity must never receive automated platform access."
          }
        ],
        "provenance": [
          "access-basalt-eligibility-policy"
        ]
      },
      {
        "id": "rule-operator-approval-required",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "eq",
              "left": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "right": {
                "kind": "literal",
                "value": "operator"
              }
            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 13
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
