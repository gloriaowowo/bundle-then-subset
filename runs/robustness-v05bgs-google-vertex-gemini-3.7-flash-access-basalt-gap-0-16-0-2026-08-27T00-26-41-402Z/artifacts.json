            },
            {
              "op": "gt",
              "left": {
                "kind": "path",
                "path": "input.riskScore"
              },
              "right": {
                "kind": "literal",
                "value": 30
              }
            }
          ]
        },
        "steps": [
          {
            "kind": "require_approval",
            "role": "platform_security_manager",
            "reason": "Member request risk score exceeds automatic threshold 30."
          }
        ],
        "provenance": [
          "access-basalt-limit-v2",
          "access-basalt-approval-policy"
        ]
      },
      {
        "id": "rule-auto-provision-access",
        "when": {
          "op": "any",
          "args": [
            {
              "op": "all",
              "args": [
                {
                  "op": "eq",
                  "left": {
                    "kind": "path",
                    "path": "input.accessClass"
                  },
                  "right": {
                    "kind": "literal",
                    "value": "operator"
                  }
                },
                {
                  "op": "lte",
                  "left": {
                    "kind": "path",
                    "path": "input.riskScore"
                  },
                  "right": {
                    "kind": "literal",
                    "value": 13
                  }
                }
              ]
            },
            {
              "op": "all",
              "args": [
                {
                  "op": "eq",
                  "left": {
                    "kind": "path",
                    "path": "input.accessClass"
                  },
                  "right": {
                    "kind": "literal",
                    "value": "member"
                  }
                },
                {
                  "op": "lte",
                  "left": {
                    "kind": "path",
                    "path": "input.riskScore"
                  },
                  "right": {
                    "kind": "literal",
                    "value": 30
                  }
                }
              ]
            }
          ]
        },
        "steps": [
          {
            "kind": "tool",
            "tool": "enable_platform_access",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "actionClass": {
                "kind": "path",
                "path": "input.accessClass"
              },
              "memberKey": {
                "kind": "path",
                "path": "input.principalId"
              },
              "scoredRisk": {
                "kind": "path",
                "path": "input.riskScore"
              }
            }
          },
          {
            "kind": "tool",
            "tool": "close_access_case",
            "args": {
              "accessCaseId": {
                "kind": "path",
                "path": "input.requestId"
              },
              "status": {
                "kind": "literal",
                "value": "enabled"
              }
            }
          }
        ],
        "provenance": [
